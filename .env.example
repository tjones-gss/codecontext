# CodeContext Live Configuration

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=your_api_key_here

# ============================================================================
# EMBEDDING PROVIDER (choose one based on your machine capabilities)
# ============================================================================
# Options: 'ollama' (local, requires powerful machine),
#          'openai' (cloud, lightweight),
#          'cohere' (cloud, lightweight),
#          'none' (no embeddings, keyword search only - works on any machine)
EMBEDDING_PROVIDER=none

# Ollama Configuration (for local embeddings - requires powerful machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# OpenAI Configuration (cloud embeddings - lightweight alternative)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Cohere Configuration (cloud embeddings - lightweight alternative)
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-english-light-v3.0

# SVN Configuration
SVN_REPO_PATH=\\\\LocalCobolSearch\\trunk\\cobol\\fujsource
SVN_USERNAME=
SVN_PASSWORD=

# Jira Configuration
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Monday.com Configuration
MONDAY_API_TOKEN=
MONDAY_API_URL=https://api.monday.com/v2

# Local Source Directories
COBOL_SOURCE_DIR=\\\\LocalCobolSearch\\trunk\\cobol\\fujsource
ADDITIONAL_SOURCE_DIRS=

# Server Configuration
PORT=3000
HOST=localhost

# Vector Store Configuration
VECTOR_STORE_PATH=./data/vector_store

# File Watching
WATCH_EXTENSIONS=.cbl,.vb,.cs
